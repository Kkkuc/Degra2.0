@model IEnumerable<WebApplication.DTOs.Room.RoomIndexDto>

@section HeaderLeft {
<div class="flex items-center gap-4">
    <h2 class="font-bold text-2xl tracking-tight">Rooms</h2>
</div>
}

<div class="p-8 space-y-6">
    <div class="bg-card border border-border rounded-2xl p-6 shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <label class="text-xs font-bold text-gray-400 uppercase">Search Room</label>
                <div class="relative mt-1">
                    <input type="text" id="search-input" placeholder="Search by number, name, capacity..."
                           class="w-full bg-gray-100 dark:bg-gray-800 border-none rounded-xl px-4 py-2.5 pl-10 text-sm focus:ring-2 focus:ring-blue-500/20" />
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                        <i data-lucide="search" class="w-4 h-4"></i>
                    </div>
                </div>
            </div>

            <div>
                <label class="text-xs font-bold text-gray-400 uppercase">Building</label>
                <select id="building-filter"
                        class="w-full bg-gray-100 dark:bg-gray-800 border-none rounded-xl px-4 py-2.5 text-sm mt-1 focus:ring-2 focus:ring-blue-500/20">
                    <option value="">All Buildings</option>
                </select>
            </div>

            <div>
                <label class="text-xs font-bold text-gray-400 uppercase">Min Capacity</label>
                <div class="relative mt-1">
                    <input type="number" id="capacity-filter" placeholder="e.g. 30" min="0"
                           class="w-full bg-gray-100 dark:bg-gray-800 border-none rounded-xl px-4 py-2.5 pl-10 text-sm focus:ring-2 focus:ring-blue-500/20" />
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                        <i data-lucide="users" class="w-4 h-4 text-gray-400"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="rooms-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    </div>
</div>

@section Scripts {
<script>
    const STORAGE_KEY = 'rooms_cache';
    const TTL = 3600000;

    let allRooms = [];

    function initRooms() {
        const serverData = @Html.Raw(Json.Serialize(Model));
        const cached = JSON.parse(localStorage.getItem(STORAGE_KEY));
        const now = Date.now();

        if (serverData && serverData.length > 0) {
            allRooms = serverData;
            localStorage.setItem(STORAGE_KEY, JSON.stringify({data: serverData, timestamp: now}));
        } else if (cached && (now - cached.timestamp < TTL)) {
            allRooms = cached.data;
        }

        populateBuildingFilter(allRooms);
        setupEventListeners();
        filterAndRenderRooms();
    }

    function populateBuildingFilter(rooms) {
        const buildingFilter = document.getElementById('building-filter');
        const uniqueBuildings = [...new Set(rooms.map(r => r.buildingName).filter(Boolean))].sort();

        uniqueBuildings.forEach(building => {
            const opt = new Option(building, building);
            buildingFilter.add(opt);
        });
    }

    function setupEventListeners() {
        document.getElementById('search-input').addEventListener('input', filterAndRenderRooms);
        document.getElementById('building-filter').addEventListener('change', filterAndRenderRooms);
        document.getElementById('capacity-filter').addEventListener('input', filterAndRenderRooms);
    }

    function filterAndRenderRooms() {
        const searchQuery = document.getElementById('search-input').value.toLowerCase().trim();
        const selectedBuilding = document.getElementById('building-filter').value;
        const minCapacity = parseInt(document.getElementById('capacity-filter').value) || 0;

        const filtered = allRooms.filter(room => {
            const roomNumberStr = (room.roomNumber || '').toString().toLowerCase();
            const buildingNameStr = (room.buildingName || '').toLowerCase();
            const capacityStr = (room.capacity || '').toString();

            const matchesSearch = !searchQuery ||
                roomNumberStr.includes(searchQuery) ||
                buildingNameStr.includes(searchQuery) ||
                capacityStr.includes(searchQuery);

            const matchesBuilding = !selectedBuilding || room.buildingName === selectedBuilding;
            const matchesCapacity = (room.capacity || 0) >= minCapacity;

            return matchesSearch && matchesBuilding && matchesCapacity;
        });

        renderRooms(filtered);
    }

    function renderRooms(rooms) {
        const container = document.getElementById('rooms-container');

        if (rooms.length === 0) {
            container.innerHTML = `
                    <div class="col-span-full py-12 text-center text-gray-500 bg-card rounded-2xl border border-border">
                        <i data-lucide="info" class="w-8 h-8 mx-auto mb-2 text-gray-400"></i>
                        <p class="font-medium">No rooms match the filtering criteria.</p>
                    </div>
                `;
            lucide.createIcons();
            return;
        }

        container.innerHTML = rooms.map(room => `
                <div class="bg-card rounded-2xl border border-border p-6 hover:shadow-lg transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-4">
                            <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-xl text-blue-600">
                                <i data-lucide="door-open" class="w-6 h-6"></i>
                            </div>
                        </div>
                        <h3 class="text-xl font-bold mb-1">Room ${room.roomNumber}</h3>
                        <p class="text-sm text-gray-500 mb-6 flex items-center gap-1">
                            <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
                            ${room.buildingName || 'Unknown Building'}
                        </p>
                    </div>
                    <div class="grid grid-cols-2 gap-4 py-4 border-t border-border mt-auto">
                        <div>
                            <div class="text-xs text-gray-400 uppercase font-medium">Capacity</div>
                            <div class="flex items-center gap-2 mt-1">
                                <i data-lucide="users" class="w-4 h-4 text-gray-400"></i>
                                <span class="font-semibold">${room.capacity}</span>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
        lucide.createIcons();
    }

    initRooms();
</script>
}