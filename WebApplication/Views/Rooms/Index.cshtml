@{
    ViewData["Title"] = "Sale";
}

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
            Sale
        </h1>

        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Lista sal wraz z przypisanymi budynkami.
        </p>
    </div>

    <div class="mb-6 rounded-xl border border-gray-200 bg-white p-5 shadow-sm
                dark:border-gray-700 dark:bg-gray-900">

        <label for="room-search"
               class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">
            Wyszukaj salę
        </label>

        <input id="room-search"
               type="search"
               autocomplete="off"
               placeholder="Numer sali lub nazwa budynku"
               class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                      dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />
    </div>

    <div id="rooms-loading"
         class="rounded-xl border border-gray-200 bg-white p-8 text-center
                text-gray-500 shadow-sm dark:border-gray-700 dark:bg-gray-900">
        Ładowanie sal...
    </div>

    <div id="rooms-empty"
         class="hidden rounded-xl border border-gray-200 bg-white p-8 text-center
                text-gray-500 shadow-sm dark:border-gray-700 dark:bg-gray-900">
        Nie znaleziono sal.
    </div>

    <div id="rooms-grid"
         class="hidden grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
    </div>

</div>

@section Scripts {
    <script src="~/js/admin-ui.js"
            asp-append-version="true"></script>

    <script src="~/js/rooms-public.js"
            asp-append-version="true"></script>
}