@model WebApplication.DTOs.Building.BuildingFormDto

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Building</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AddressDto.Street" class="control-label"></label>
                <input asp-for="AddressDto.Street" class="form-control" />
                <span asp-validation-for="AddressDto.Street" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AddressDto.HouseNumber" class="control-label"></label>
                <input asp-for="AddressDto.HouseNumber" class="form-control" />
                <span asp-validation-for="AddressDto.HouseNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AddressDto.City" class="control-label"></label>
                <input asp-for="AddressDto.City" class="form-control" />
                <span asp-validation-for="AddressDto.City" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AddressDto.PostalCode" class="control-label"></label>
                <input asp-for="AddressDto.PostalCode" class="form-control" />
                <span asp-validation-for="AddressDto.PostalCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FacultyId" class="control-label"></label>
                <select asp-for="FacultyId" class ="form-control" asp-items="ViewBag.FacultyId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

