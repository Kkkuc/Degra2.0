@{
    ViewData["Title"] = "Semestry";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <partial name="Partials/_AdminNav" />

    <div class="flex flex-col gap-6">

        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
                    Semestry
                </h1>

                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Zarządzanie semestrami, datami ich trwania oraz przypisaniem do lat akademickich.
                </p>
            </div>

            <button type="button"
                    onclick="openCreateModal()"
                    class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2
                           text-sm font-semibold text-white shadow-sm transition-colors hover:bg-blue-700">
                Dodaj semestr
            </button>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm
                    dark:border-gray-700 dark:bg-gray-900">

            <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-gray-100">
                Filtry
            </h2>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">

                <div>
                    <label for="filter-name-input"
                           class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">
                        Nazwa semestru
                    </label>

                    <input id="filter-name-input"
                           type="text"
                           list="semester-names-list"
                           autocomplete="off"
                           placeholder="Np. Semestr zimowy"
                           class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                                  text-gray-900 focus:border-blue-500 focus:ring-blue-500
                                  dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />

                    <datalist id="semester-names-list"></datalist>
                </div>

                <div>
                    <label for="filter-academicYearId"
                           class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">
                        Rok akademicki
                    </label>

                    <select id="filter-academicYearId"
                            class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                                   text-gray-900 focus:border-blue-500 focus:ring-blue-500
                                   dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100">

                        <option value="">Wszystkie lata</option>
                    </select>
                </div>

                <div class="flex items-end gap-3">
                    <button type="button"
                            onclick="applyFilters()"
                            class="flex-1 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold
                                   text-white transition-colors hover:bg-blue-700">
                        Filtruj
                    </button>

                    <button type="button"
                            onclick="clearFilters()"
                            class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm
                                   font-semibold text-gray-700 hover:bg-gray-50
                                   dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200
                                   dark:hover:bg-gray-700">
                        Wyczyść
                    </button>
                </div>

            </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm
                    dark:border-gray-700 dark:bg-gray-900">

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">

                    <thead class="bg-gray-50 dark:bg-gray-800">
                    <tr>
                        <th class="p-4 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Nazwa
                        </th>

                        <th class="p-4 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Rok akademicki
                        </th>

                        <th class="p-4 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Data rozpoczęcia
                        </th>

                        <th class="p-4 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Data zakończenia
                        </th>

                        <th class="p-4 text-right text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Akcje
                        </th>
                    </tr>
                    </thead>

                    <tbody id="semesters-rows"
                           class="divide-y divide-gray-100 dark:divide-gray-800">
                    </tbody>

                </table>
            </div>
        </div>

    </div>
</div>

<partial name="Partials/_SemesterModal" />

@section Scripts {
    <script src="~/js/admin-ui.js" asp-append-version="true"></script>
    <script src="~/js/admin-semesters.js" asp-append-version="true"></script>
}