@{
    ViewData["Title"] = "Sale";
}

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <partial name="Partials/_AdminNav" />

    <div class="flex flex-col gap-6">

        <div class="flex flex-col gap-4 sm:flex-row
                    sm:items-center sm:justify-between">

            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
                    Sale
                </h1>

                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Zarządzanie salami oraz przypisaniem do budynków.
                </p>
            </div>

            <button type="button"
                    onclick="openCreateModal()"
                    class="rounded-lg bg-blue-600 px-4 py-2 text-sm
                           font-semibold text-white shadow-sm hover:bg-blue-700">
                Dodaj salę
            </button>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm
                    dark:border-gray-700 dark:bg-gray-900">

            <h2 class="mb-4 text-lg font-semibold">
                Filtry
            </h2>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">

                <div>
                    <label for="filter-search"
                           class="mb-1 block text-sm font-medium">
                        Sala
                    </label>

                    <input id="filter-search"
                           type="text"
                           list="room-suggestions"
                           autocomplete="off"
                           placeholder="Numer sali lub budynek..."
                           class="w-full rounded-lg border border-gray-300
                                  px-3 py-2 dark:border-gray-600 dark:bg-gray-800" />

                    <datalist id="room-suggestions"></datalist>
                    <input id="filter-room-id" type="hidden" />
                </div>

                <div>
                    <label for="filter-buildingId"
                           class="mb-1 block text-sm font-medium">
                        Budynek
                    </label>

                    <select id="filter-buildingId"
                            class="w-full rounded-lg border border-gray-300
                                   px-3 py-2 dark:border-gray-600 dark:bg-gray-800">
                        <option value="">Wszystkie budynki</option>
                    </select>
                </div>

                <div class="flex items-end gap-3">

                    <button type="button"
                            onclick="applyFilters()"
                            class="flex-1 rounded-lg bg-blue-600 px-4 py-2
                                   text-sm font-semibold text-white hover:bg-blue-700">
                        Filtruj
                    </button>

                    <button type="button"
                            onclick="clearFilters()"
                            class="rounded-lg border border-gray-300 px-4 py-2
                                   text-sm font-semibold">
                        Wyczyść
                    </button>
                </div>

            </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-gray-200
                    bg-white shadow-sm dark:border-gray-700 dark:bg-gray-900">

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200
                              dark:divide-gray-700">

                    <thead class="bg-gray-50 dark:bg-gray-800">
                    <tr>
                        <th class="p-4 text-left text-xs font-semibold
                                   uppercase text-gray-500">
                            Numer sali
                        </th>

                        <th class="p-4 text-left text-xs font-semibold
                                   uppercase text-gray-500">
                            Budynek
                        </th>

                        <th class="p-4 text-right text-xs font-semibold
                                   uppercase text-gray-500">
                            Akcje
                        </th>
                    </tr>
                    </thead>

                    <tbody id="rooms-rows"
                           class="divide-y divide-gray-100 dark:divide-gray-800">
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>

<partial name="Partials/_RoomModal" />

@section Scripts {
    <script src="~/js/admin-ui.js"
            asp-append-version="true"></script>

    <script src="~/js/admin-rooms.js"
            asp-append-version="true"></script>
}