@model IEnumerable<WebApplication.DTOs.Building.BuildingIndexDto>
@{
    ViewData["Title"] = "Zarządzanie Budynkami";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="px-8 pt-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Panel Administratora</h1>

    <partial name="Partials/_AdminNav" />

    <div class="flex justify-between items-center mb-6">
        <h2 class="text-lg font-bold text-gray-800 dark:text-gray-200">Zarządzanie budynkami</h2>
        <a asp-action="CreateBuilding"
           class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-sm text-sm">
            + Dodaj Nowy Budynek
        </a>
    </div>

    <div class="bg-card border border-border rounded-2xl shadow-sm overflow-x-auto">
        <table class="w-full border-collapse min-w-[600px]">
            <thead>
                <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-border text-left">
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Nazwa Budynku</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Wydział</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase text-right">Akcje</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                @foreach (var b in Model)
                {
                    <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/20 transition-colors">
                        <td class="p-4 text-sm font-semibold text-gray-900 dark:text-gray-100">@b.Name</td>
                        <td class="p-4 text-sm text-gray-600 dark:text-gray-400">
                            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded-lg text-xs font-medium text-gray-700 dark:text-gray-300">
                                @b.FacultyAbbreviation
                            </span>
                        </td>
                        <td class="p-4 text-sm text-right space-x-2">
                            <a asp-action="EditBuilding" asp-route-id="@b.Id" class="text-blue-600 hover:underline font-medium">Edytuj</a>
                            <span class="text-gray-300">|</span>
                            <a asp-action="DeleteBuilding" asp-route-id="@b.Id" class="text-red-600 hover:underline font-medium" onclick="return confirm('Czy na pewno usunąć?')">Usuń</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>