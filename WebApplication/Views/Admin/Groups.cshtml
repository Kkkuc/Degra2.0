@{
    ViewData["Title"] = "Grupy";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <partial name="Partials/_AdminNav"/>

    <div class="flex flex-col gap-6">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
                    Grupy
                </h1>

                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Zarządzanie grupami przypisanymi do kierunków i semestrów.
                </p>
            </div>

            <button type="button"
                    onclick="openCreateModal()"
                    class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition-colors">
                Dodaj grupę
            </button>
        </div>

        <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm
                    dark:border-gray-700 dark:bg-gray-900">

            <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-gray-100">
                Filtry
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-4">

                <div>
                    <label for="filter-name-input"
                           class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
                        Nazwa grupy
                    </label>

                    <input id="filter-name-input"
                           type="text"
                           list="group-names-list"
                           autocomplete="off"
                           placeholder="Np. L1"
                           class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                                  text-gray-900 focus:border-blue-500 focus:ring-blue-500
                                  dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100" />

                    <datalist id="group-names-list"></datalist>
                </div>

                <div>
                    <label for="filter-semesterId"
                           class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
                        Semestr
                    </label>

                    <select id="filter-semesterId"
                            class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                                   text-gray-900 focus:border-blue-500 focus:ring-blue-500
                                   dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100">
                        <option value="">Wszystkie</option>
                    </select>
                </div>

                <div>
                    <label for="filter-fieldOfStudyId"
                           class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
                        Kierunek
                    </label>

                    <select id="filter-fieldOfStudyId"
                            class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                                   text-gray-900 focus:border-blue-500 focus:ring-blue-500
                                   dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100">
                        <option value="">Wszystkie</option>
                    </select>
                </div>

                <div>
                    <label for="filter-specializationId"
                           class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
                        Specjalizacja
                    </label>

                    <select id="filter-specializationId"
                            class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                                   text-gray-900 focus:border-blue-500 focus:ring-blue-500
                                   dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100">
                        <option value="">Wszystkie</option>
                    </select>
                </div>

                <div>
                    <label for="filter-classType"
                           class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
                        Typ zajęć
                    </label>

                    <select id="filter-classType"
                            class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm
                                   text-gray-900 focus:border-blue-500 focus:ring-blue-500
                                   dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100">
                        <option value="">Wszystkie</option>
                    </select>
                </div>
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
                <button type="button"
                        onclick="applyFilters()"
                        class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition-colors">
                    Filtruj
                </button>

                <button type="button"
                        onclick="clearFilters()"
                        class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold
                               text-gray-700 hover:bg-gray-50 transition-colors
                               dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">
                    Wyczyść
                </button>
            </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm
                    dark:border-gray-700 dark:bg-gray-900">

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-gray-800">
                    <tr>
                        <th class="p-4 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Grupa
                        </th>

                        <th class="p-4 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Semestr
                        </th>

                        <th class="p-4 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Kierunek
                        </th>

                        <th class="p-4 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Specjalizacja
                        </th>

                        <th class="p-4 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Typ zajęć
                        </th>

                        <th class="p-4 text-right text-xs font-semibold uppercase tracking-wide text-gray-500">
                            Akcje
                        </th>
                    </tr>
                    </thead>

                    <tbody id="groups-rows"
                           class="divide-y divide-gray-100 dark:divide-gray-800">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="Partials/_GroupModal" />

@section Scripts {
    <script src="~/js/admin-ui.js" asp-append-version="true"></script>
    <script src="~/js/admin-groups.js" asp-append-version="true"></script>
}