@using WebApplication.Models.enums
@model IEnumerable<WebApplication.DTOs.Admin.UserListDto>
@{
    ViewData["Title"] = "Panel Administratora";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="px-8 pt-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Panel Administratora</h1>

    <div class="flex border-b border-border mb-6">
        <button onclick="switchTab('tab-timetable')" id="btn-tab-timetable"
                class="px-6 py-3 font-semibold text-sm border-b-2 border-blue-600 text-blue-600 transition-colors focus:outline-none">
            Zarządzanie Planem (Timetables)
        </button>
        <button onclick="switchTab('tab-users')" id="btn-tab-users"
                class="px-6 py-3 font-semibold text-sm border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors focus:outline-none">
            Użytkownicy
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 p-4 bg-green-50 border border-green-200 text-green-800 rounded-xl text-sm font-medium">
            @TempData["SuccessMessage"]
        </div>
    }

    <div id="tab-timetable" class="tab-content">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-lg font-bold text-gray-800 dark:text-gray-200">Wpisy w planie zajęć</h2>
            <button onclick="openCreateModal()"
                    class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-sm text-sm">
                + Dodaj Nowe Zajęcia
            </button>
        </div>

        <div class="bg-card border border-border rounded-2xl shadow-sm overflow-x-auto">
            <table class="w-full border-collapse min-w-[800px]">
                <thead>
                <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-border text-left">
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Przedmiot</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Prowadzący</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Sala</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Grupa</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Typ</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Dzień</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Cykl Tygodniowy</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Czas</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase text-right">Akcje</th>
                </tr>
                </thead>
                <tbody id="timetable-rows" class="divide-y divide-border">
                </tbody>
            </table>
        </div>
    </div>

    <div style="background-color: #f8f9fa; padding: 20px; border: 1px solid #dee2e6; border-radius: 4px; margin-bottom: 20px; max-width: 450px;">
        <form asp-controller="Admin" asp-action="GenerateMonthlyStats" method="get" target="_blank">
            <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                <div style="flex: 1;">
                    <label style="font-size: 13px; font-weight: bold;">Rok:</label>
                    <input type="number" name="rok" value="@DateTime.Now.Year" min="2024" max="2030" style="width: 100%; padding: 6px;" />
                </div>
                <div style="flex: 1;">
                    <label style="font-size: 13px; font-weight: bold;">Miesiąc:</label>
                    <select name="miesiac" style="width: 100%; padding: 6px;">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(i == DateTime.Now.Month)">@i (@(new DateTime(2000, i, 1).ToString("MMMM")))</option>
                        }
                    </select>
                </div>
            </div>
            <button type="submit" style="background-color: #dc3545; color: white; border: none; padding: 10px 15px; cursor: pointer; width: 100%; border-radius: 4px; font-weight: bold;">
                Wygeneruj Raport Zmian
            </button>
        </form>
    </div>
    
    <div id="tab-users" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <div class="lg:col-span-2">
                <h2 class="text-lg font-bold text-gray-800 dark:text-gray-200 mb-4">Zarejestrowani użytkownicy</h2>
                <div class="bg-card border border-border rounded-2xl shadow-sm overflow-x-auto">
                    <table class="w-full border-collapse">
                        <thead>
                        <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-border text-left">
                            <th class="p-4 text-xs font-bold text-gray-500 uppercase w-16">ID</th>
                            <th class="p-4 text-xs font-bold text-gray-500 uppercase">Nazwa Użytkownika (Login)</th>
                            <th class="p-4 text-xs font-bold text-gray-500 uppercase">Rola</th>
                        </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                        @foreach (var user in Model)
                        {
                            <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/20 transition-colors">
                                <td class="p-4 text-sm text-gray-500">@user.Id</td>
                                <td class="p-4 text-sm font-semibold text-gray-900 dark:text-gray-100">@user.Username</td>
                                <td class="p-4 text-sm text-gray-600 dark:text-gray-400">
                                        <span
                                            class="px-2 py-1 text-xs font-bold rounded-md bg-purple-50 text-purple-700 border border-purple-200">
                                            @user.RoleName
                                        </span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div>
                <h2 class="text-lg font-bold text-gray-800 dark:text-gray-200 mb-4">Utwórz konto pracownika /
                    studenta</h2>
                <div class="bg-card border border-border rounded-2xl shadow-sm p-6">
                    <form asp-controller="Admin" asp-action="CreateAccount" method="post" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-400">Login:</label>
                            <input type="text" name="username" required
                                   class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"/>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-400">Adres e-mail:</label>
                            <input type="email" name="email" required
                                   class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"/>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-400">Hasło tymczasowe:</label>
                            <input type="password" name="tempPassword" required
                                   class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"/>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-400">Wybierz Rolę:</label>
                            <select name="roleId" asp-items="ViewBag.Roles" required
                                    class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500">
                                <option value="">-- Wybierz --</option>
                            </select>
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly"
                                 class="text-red-600 text-xs font-semibold bg-red-50 dark:bg-red-900/20 p-3 rounded-xl border border-red-200 dark:border-red-800"></div>
                        }

                        <button type="submit"
                                class="w-full py-2.5 bg-green-600 text-white rounded-xl text-sm font-bold shadow-md hover:bg-green-700 transition-colors border-none">
                            Utwórz i Zapisz w Bazie
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<div id="crud-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-card w-full max-w-lg rounded-2xl shadow-2xl border border-border m-4 p-6">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-border">
            <h3 id="modal-title" class="font-bold text-xl">Dodaj zajęcia</h3>
            <button onclick="closeCrudModal()" class="text-gray-500 hover:text-gray-700">✕</button>
        </div>

        <form id="timetable-form" onsubmit="handleFormSubmit(event)" class="space-y-4">
            <input type="hidden" id="form-id"/>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Przedmiot</label>
                    <select id="form-subjectId" required asp-items="ViewBag.SubjectId"
                            class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Prowadzący</label>
                    <select id="form-teacherId" required asp-items="ViewBag.TeacherId"
                            class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Sala</label>
                    <select id="form-roomId" required asp-items="ViewBag.RoomId"
                            class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Grupa</label>
                    <select id="form-groupId" required asp-items="ViewBag.GroupId"
                            class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Typ zajęć</label>
                    <select id="form-classType" required asp-items="Html.GetEnumSelectList<ClassType>()"
                            class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Dzień tygodnia</label>
                    <select id="form-dayOfWeek" required asp-items="Html.GetEnumSelectList<DayOfWeek>()"
                            class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Start</label>
                    <input type="time" id="form-startTime" required
                           class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"/>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Koniec</label>
                    <input type="time" id="form-endTime" required
                           class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"/>
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold uppercase text-gray-400">Cykl tygodnia</label>
                <select id="form-weekCycle" required asp-items="Html.GetEnumSelectList<WeekCycle>()"
                        class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-border">
                <button type="button" onclick="closeCrudModal()"
                        class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded-xl text-sm font-medium">Anuluj
                </button>
                <button type="submit"
                        class="px-6 py-2 bg-blue-600 text-white rounded-xl text-sm font-bold shadow-md hover:bg-blue-700">
                    Zapisz
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = '/api/Timetables';
        let allLessons = [];

        // Mapowanie tekstowe Enumów na froncie na podstawie wartości liczbowych z bazy
        const classTypes = {0: "Wykład", 1: "Laboratorium", 2: "Ćwiczenia", 3: "Projekt"};
        const daysOfWeek = {
            0: "Niedziela",
            1: "Poniedziałek",
            2: "Wtorek",
            3: "Środa",
            4: "Czwartek",
            5: "Piątek",
            6: "Sobota"
        };
        const weekCycles = {0: "Co tydzień", 1: "Tydzień Parzysty", 2: "Tydzień Nieparzysty"};

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(tabId).classList.remove('hidden');
            const btnTimetable = document.getElementById('btn-tab-timetable');
            const btnUsers = document.getElementById('btn-tab-users');

            if (tabId === 'tab-timetable') {
                btnTimetable.className = "px-6 py-3 font-semibold text-sm border-b-2 border-blue-600 text-blue-600 transition-colors focus:outline-none";
                btnUsers.className = "px-6 py-3 font-semibold text-sm border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors focus:outline-none";
            } else {
                btnTimetable.className = "px-6 py-3 font-semibold text-sm border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors focus:outline-none";
                btnUsers.className = "px-6 py-3 font-semibold text-sm border-b-2 border-blue-600 text-blue-600 transition-colors focus:outline-none";
            }


        }

        async function fetchLessons() {
            try {
                const response = await fetch(API_URL);
                if (!response.ok) throw new Error("Błąd API.");
                allLessons = await response.json();
                renderTable();
            } catch (err) {
                console.error(err);
            }


        }

        function renderTable() {
            const tbody = document.getElementById('timetable-rows');

            tbody.innerHTML = allLessons.map(l => `
        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/20 transition-colors">
            <td class="p-4 text-sm font-semibold text-gray-900 dark:text-gray-100">${l.subjectName}</td>
            <td class="p-4 text-sm text-gray-600 dark:text-gray-400">${l.teacherName}</td>
            <td class="p-4 text-sm text-gray-500">${l.roomNumber}</td>
            <td class="p-4 text-sm text-gray-500">${l.groupName}</td>
            <td class="p-4 text-sm text-gray-500">
                <span class="px-2 py-0.5 bg-gray-100 dark:bg-gray-800 rounded text-xs font-medium">
                    ${classTypes[l.classType] !== undefined ? classTypes[l.classType] : l.classType}
                </span>
            </td>
            <td class="p-4 text-sm text-gray-500">${daysOfWeek[l.dayOfWeek] || l.dayOfWeek}</td>
            <td class="p-4 text-sm text-gray-500">${weekCycles[l.weekCycle] || l.weekCycle}</td>
            <td class="p-4 text-sm text-gray-500">${l.startTime.substring(0, 5)} - ${l.endTime.substring(0, 5)}</td>
            <td class="p-4 text-sm text-right space-x-2">
                <button onclick="openEditModal(${l.id})" class="text-blue-600 hover:underline font-medium">Edytuj</button>
                <span class="text-gray-300">|</span>
                <button onclick="deleteLesson(${l.id})" class="text-red-600 hover:underline font-medium">Usuń</button>
            </td>
        </tr>
    `).join('');
        }

        async function handleFormSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('form-id').value;

            const payload = {
                subjectId: parseInt(document.getElementById('form-subjectId').value),
                teacherId: parseInt(document.getElementById('form-teacherId').value),
                roomId: parseInt(document.getElementById('form-roomId').value),
                groupId: parseInt(document.getElementById('form-groupId').value),
                classType: parseInt(document.getElementById('form-classType').value),
                dayOfWeek: parseInt(document.getElementById('form-dayOfWeek').value),
                weekCycle: parseInt(document.getElementById('form-weekCycle').value),
                startTime: document.getElementById('form-startTime').value,
                endTime: document.getElementById('form-endTime').value
            };

            const isEdit = id !== "";
            if (isEdit) payload.id = parseInt(id);

            try {
                const response = await fetch(isEdit ? `${API_URL}/${id}` : API_URL, {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    closeCrudModal();
                    fetchLessons();
                } else {
                    alert("Wystąpił błąd podczas zapisu danych.");
                }
            } catch (err) {
                console.error(err);
            }


        }

        function openCreateModal() {
            document.getElementById('modal-title').innerText = "Dodaj nowe zajęcia";
            document.getElementById('timetable-form').reset();
            document.getElementById('form-id').value = "";
            document.getElementById('crud-modal').classList.remove('hidden');
        }

        // Wykorzystujemy Twój endpoint API Details: GET /api/Timetables/{id}
        async function openEditModal(id) {
            try {
                const response = await fetch(`${API_URL}/${id}`);
                if (!response.ok) return;
                const l = await response.json();

                document.getElementById('modal-title').innerText = "Edytuj zajęcia";
                document.getElementById('form-id').value = l.id;

                // Ponieważ Twój DetailsDto zwraca klucze typu SubjectId, TeacherId, idealnie mapujemy je na selecty
                document.getElementById('form-subjectId').value = l.subjectId;
                document.getElementById('form-teacherId').value = l.teacherId;
                document.getElementById('form-roomId').value = l.roomId;
                document.getElementById('form-groupId').value = l.groupId;
                document.getElementById('form-classType').value = l.classType;
                document.getElementById('form-dayOfWeek').value = l.dayOfWeek;
                document.getElementById('form-weekCycle').value = l.weekCycle;
                document.getElementById('form-startTime').value = l.startTime.substring(0, 5);
                document.getElementById('form-endTime').value = l.endTime.substring(0, 5);

                document.getElementById('crud-modal').classList.remove('hidden');
            } catch (err) {
                console.error(err);
            }


        }

        function closeCrudModal() {
            document.getElementById('crud-modal').classList.add('hidden');
        }

        async function deleteLesson(id) {
            if (!confirm("Usunąć ten wpis z planu zajęć?")) return;
            try {
                const response = await fetch(`${API_URL}/${id}`, {method: 'DELETE'});
                if (response.ok) {
                    allLessons = allLessons.filter(l => l.id !== id);
                    renderTable();
                }
            } catch (err) {
                console.error(err);
            }


        }

        document.addEventListener("DOMContentLoaded", fetchLessons);

        @if (!ViewData.ModelState.IsValid)
        {
            <text>switchTab('tab-users');</text>
        }
    </script>
}