@model IEnumerable<WebApplication.Models.User>
@{
    ViewData["Title"] = "Zarządzanie Użytkownikami";
}

<h2>Panel Moderatora - Użytkownicy</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background-color: #d4edda; color: #155724; padding: 10px; margin-bottom: 15px;">
        @TempData["SuccessMessage"]
    </div>
}

<div style="margin-bottom: 15px;">
    <a asp-controller="Admin" asp-action="UtworzKonto" style="background-color: blue; color: white; padding: 8px 12px; text-decoration: none;">
        + Dodaj Nowego Użytkownika
    </a>
</div>

<table border="1" cellpadding="10" cellspacing="0" style="width: 100%; max-width: 600px;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th>ID</th>
            <th>Nazwa Użytkownika (Login)</th>
            <th>Rola</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Username</td>
                <td>@user.Role.Name</td>
            </tr>
        }
    </tbody>
</table>