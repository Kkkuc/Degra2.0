@model IEnumerable<WebApplication.Models.User>
@{
    ViewData["Title"] = "Zarządzanie Użytkownikami";
}

<h2>Panel Moderatora - Użytkownicy</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background-color: #d4edda; color: #155724; padding: 10px; margin-bottom: 15px;">
        @TempData["SuccessMessage"]
    </div>
}

<div style="margin-bottom: 20px; display: flex; gap: 10px;">
    <a asp-controller="Admin" asp-action="UtworzKonto" style="background-color: blue; color: white; padding: 10px 15px; text-decoration: none; border-radius: 4px;">
        + Dodaj Nowego Użytkownika
    </a>
    @* moze kiedy sie przyda *@
    @* <a asp-controller="Admin" asp-action="GenerujRaportLogowPdf" target="_blank" style="background-color: #dc3545; color: white; padding: 10px 15px; text-decoration: none; border-radius: 4px;">
        📄 Generuj Raport Zmian (PDF)
    </a> *@
</div>  

<div style="background-color: #f8f9fa; padding: 20px; border: 1px solid #dee2e6; border-radius: 4px; margin-bottom: 20px; max-width: 450px;">
    <form asp-controller="Admin" asp-action="GenerateMonthlyStats" method="get" target="_blank">
        <div style="display: flex; gap: 10px; margin-bottom: 15px;">
            <div style="flex: 1;">
                <label style="font-size: 13px; font-weight: bold;">Rok:</label>
                <input type="number" name="rok" value="@DateTime.Now.Year" min="2024" max="2030" style="width: 100%; padding: 6px;" />
            </div>
            <div style="flex: 1;">
                <label style="font-size: 13px; font-weight: bold;">Miesiąc:</label>
                <select name="miesiac" style="width: 100%; padding: 6px;">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == DateTime.Now.Month)">@i (@(new DateTime(2000, i, 1).ToString("MMMM")))</option>
                    }
                </select>
            </div>
        </div>
        <button type="submit" style="background-color: #dc3545; color: white; border: none; padding: 10px 15px; cursor: pointer; width: 100%; border-radius: 4px; font-weight: bold;">
             Wygeneruj Raport Zmian
        </button>
    </form>
</div>

<table border="1" cellpadding="10" cellspacing="0" style="width: 100%; max-width: 600px;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th>ID</th>
            <th>Nazwa Użytkownika (Login)</th>
            <th>Rola</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Username</td>
                <td>@user.Role.Name</td>
            </tr>
        }
    </tbody>
</table>