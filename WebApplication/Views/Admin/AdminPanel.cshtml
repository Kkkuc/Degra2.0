@model IEnumerable<WebApplication.DTOs.Admin.UserListDto>
@{
    ViewData["Title"] = "Panel Administratora";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="admin-data" class="hidden" data-is-invalid="@(!ViewData.ModelState.IsValid ? "true" : "false")"></div>

<div class="px-8 pt-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Panel Administratora</h1>

    <div class="flex border-b border-border mb-6">
        <button onclick="switchTab('tab-timetable')" id="btn-tab-timetable"
                class="px-6 py-3 font-semibold text-sm border-b-2 border-blue-600 text-blue-600 transition-colors focus:outline-none">
            Zarządzanie Planem (Timetables)
        </button>
        <button onclick="switchTab('tab-users')" id="btn-tab-users"
                class="px-6 py-3 font-semibold text-sm border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors focus:outline-none">
            Użytkownicy
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 p-4 bg-green-50 border border-green-200 text-green-800 rounded-xl text-sm font-medium">
            @TempData["SuccessMessage"]
        </div>
    }

    <partial name="Partials/_TimetableTab" />
    <partial name="Partials/_UsersTab" model="Model" />
</div>

<partial name="Partials/_CrudModal" />

@section Scripts {
    <script src="~/js/admin-panel.js" asp-append-version="true"></script>
}