<div id="crud-modal"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">

    <div class="max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-xl
                bg-white shadow-xl dark:bg-gray-900">

        <div class="sticky top-0 flex items-center justify-between border-b
                    bg-white px-6 py-4 dark:border-gray-700 dark:bg-gray-900">

            <h2 id="modal-title"
                class="text-xl font-bold text-gray-900 dark:text-gray-100">
                Dodaj studenta
            </h2>

            <button type="button"
                    onclick="closeCrudModal()"
                    class="text-2xl text-gray-400">
                &times;
            </button>
        </div>

        <form id="student-form"
              onsubmit="handleFormSubmit(event)"
              class="space-y-5 p-6">

            <input id="form-id" type="hidden" />

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

                <div>
                    <label for="form-firstName"
                           class="mb-1 block text-sm font-medium">
                        Imię
                    </label>

                    <input id="form-firstName"
                           type="text"
                           required
                           maxlength="100"
                           class="w-full rounded-lg border px-3 py-2 dark:bg-gray-800" />
                </div>

                <div>
                    <label for="form-lastName"
                           class="mb-1 block text-sm font-medium">
                        Nazwisko
                    </label>

                    <input id="form-lastName"
                           type="text"
                           required
                           maxlength="100"
                           class="w-full rounded-lg border px-3 py-2 dark:bg-gray-800" />
                </div>

            </div>

            <div>
                <label for="form-studentId"
                       class="mb-1 block text-sm font-medium">
                    Numer albumu
                </label>

                <input id="form-studentId"
                       type="text"
                       required
                       maxlength="20"
                       class="w-full rounded-lg border px-3 py-2 dark:bg-gray-800" />
            </div>

            <div>
                <div class="mb-2 flex items-center justify-between">
                    <label class="block text-sm font-medium">
                        Przypisane grupy
                    </label>

                    <span id="selected-groups-count"
                          class="text-sm text-gray-500">
                        Wybrano: 0
                    </span>
                </div>

                <input id="group-search-input"
                       type="text"
                       placeholder="Wyszukaj grupę..."
                       oninput="renderGroupCheckboxes()"
                       class="mb-3 w-full rounded-lg border px-3 py-2 dark:bg-gray-800" />

                <div id="form-groups-list"
                     class="max-h-72 space-y-2 overflow-y-auto rounded-lg border p-3
                            dark:border-gray-700">
                </div>
            </div>

            <div class="flex justify-end gap-3 border-t pt-5">
                <button type="button"
                        onclick="closeCrudModal()"
                        class="rounded-lg border px-4 py-2 text-sm font-semibold">
                    Anuluj
                </button>

                <button type="submit"
                        class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white">
                    Zapisz
                </button>
            </div>

        </form>
    </div>
</div>