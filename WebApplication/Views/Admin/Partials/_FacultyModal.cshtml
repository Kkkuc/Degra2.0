<div id="crud-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50">
    <div class="bg-white dark:bg-gray-800 rounded-2xl w-full max-w-lg p-6 shadow-xl">
        <h2 id="modal-title" class="text-xl font-bold mb-4 text-gray-900 dark:text-gray-100">Dodaj Wydział</h2>
        <form id="faculty-form" onsubmit="handleFormSubmit(event)">
            <input type="hidden" id="form-id">
            
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Skrót</label>
                    <input type="text" id="form-abbreviation" required maxlength="10"
                           class="w-full mt-1 p-2 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-900">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Nazwa pełna</label>
                    <input type="text" id="form-name" required maxlength="100"
                           class="w-full mt-1 p-2 rounded-xl border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-900">
                </div>
            </div>

            <div class="mt-6 flex justify-end space-x-3">
                <button type="button" onclick="closeCrudModal()" 
                        class="px-4 py-2 text-gray-600 dark:text-gray-300 hover:underline">Anuluj</button>
                <button type="submit" 
                        class="px-4 py-2 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700">Zapisz</button>
            </div>
        </form>
    </div>
</div>