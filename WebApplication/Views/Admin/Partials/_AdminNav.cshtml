<div class="flex space-x-6 overflow-x-auto border-b border-gray-200 dark:border-gray-700 mb-6">
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <a asp-action="Timetable"
       class="px-6 py-3 font-semibold text-sm border-b-2 transition-colors focus:outline-none 
       @(currentAction == "Timetable" ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700")">
        Zajęcia
    </a>

    <a asp-action="Users"
       class="px-6 py-3 font-semibold text-sm border-b-2 transition-colors focus:outline-none 
       @(currentAction == "Users" ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700")">
        Użytkownicy
    </a>

    <a asp-action="Reports"
       class="px-6 py-3 font-semibold text-sm border-b-2 transition-colors focus:outline-none 
       @(currentAction == "Reports" ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700")">
        Raporty
    </a>

    <a asp-action="Buildings"
       class="px-6 py-3 font-semibold text-sm border-b-2 transition-colors focus:outline-none 
       @(currentAction == "Buildings" ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700")">
        Budynki
    </a>

    <a asp-action="Faculties"
       class="px-6 py-3 font-semibold text-sm border-b-2 transition-colors focus:outline-none 
        @(currentAction == "Faculties" ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700")">
        Wydziały
    </a>

    <a asp-action="FieldOfStudy"
       class="px-6 py-3 font-semibold text-sm border-b-2 transition-colors focus:outline-none 
        @(currentAction == "FieldOfStudy" ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700")">
        Kierunki
    </a>
    
    <a asp-controller="Admin"
       asp-action="Groups"
       class="px-6 py-3 font-semibold text-sm border-b-2 whitespace-nowrap transition-colors focus:outline-none
          @(currentAction == "Groups"
              ? "border-blue-600 text-blue-600"
              : "border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200")">
        Grupy
    </a>
    
    <a asp-controller="Admin"
       asp-action="Semesters"
       class="px-6 py-3 font-semibold text-sm border-b-2 whitespace-nowrap transition-colors focus:outline-none
          @(currentAction == "Semesters"
              ? "border-blue-600 text-blue-600"
              : "border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200")">
        Semestry
    </a>
</div>