<div id="tab-timetable" class="tab-content">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-lg font-bold text-gray-800 dark:text-gray-200">Wpisy w planie zajęć</h2>
        <button onclick="openCreateModal()"
                class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-sm text-sm">
            + Dodaj Nowe Zajęcia
        </button>
    </div>

    <div class="bg-card border border-border rounded-2xl shadow-sm overflow-x-auto">
        <table class="w-full border-collapse min-w-[800px]">
            <thead>
                <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-border text-left">
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Przedmiot</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Prowadzący</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Sala</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Grupa</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Typ</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Dzień</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Cykl Tygodniowy</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase">Czas</th>
                    <th class="p-4 text-xs font-bold text-gray-500 uppercase text-right">Akcje</th>
                </tr>
            </thead>
            <tbody id="timetable-rows" class="divide-y divide-border"></tbody>
        </table>
    </div>
</div>