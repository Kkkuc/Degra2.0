@using WebApplication.Models.enums
<div id="crud-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-card w-full max-w-lg rounded-2xl shadow-2xl border border-border m-4 p-6">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-border">
            <h3 id="modal-title" class="font-bold text-xl">Dodaj zajęcia</h3>
            <button onclick="closeCrudModal()" class="text-gray-500 hover:text-gray-700">✕</button>
        </div>
        <form id="timetable-form" onsubmit="handleFormSubmit(event)" class="space-y-4">
            <input type="hidden" id="form-id"/>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Przedmiot</label>
                    <select id="form-subjectId" required asp-items="ViewBag.SubjectId" class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Prowadzący</label>
                    <select id="form-teacherId" required asp-items="ViewBag.TeacherId" class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Sala</label>
                    <select id="form-roomId" required asp-items="ViewBag.RoomId" class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Grupa</label>
                    <select id="form-groupId" required asp-items="ViewBag.GroupId" class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Typ zajęć</label>
                    <select id="form-classType" required asp-items="Html.GetEnumSelectList<ClassType>()" class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Dzień tygodnia</label>
                    <select id="form-dayOfWeek" required asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Start</label>
                    <input type="time" id="form-startTime" required class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"/>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-400">Koniec</label>
                    <input type="time" id="form-endTime" required class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"/>
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold uppercase text-gray-400">Cykl tygodnia</label>
                <select id="form-weekCycle" required asp-items="Html.GetEnumSelectList<WeekCycle>()" class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none focus:ring-2 focus:ring-blue-500"></select>
            </div>
            <div class="flex justify-end gap-3 pt-4 border-t border-border">
                <button type="button" onclick="closeCrudModal()" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded-xl text-sm font-medium">Anuluj</button>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-xl text-sm font-bold shadow-md hover:bg-blue-700">Zapisz</button>
            </div>
        </form>
    </div>
</div>