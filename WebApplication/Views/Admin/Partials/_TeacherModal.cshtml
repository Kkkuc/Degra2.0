<div id="crud-modal"
     class="fixed inset-0 z-50 hidden items-center
            justify-center bg-black/50 p-4">

    <div class="w-full max-w-2xl rounded-xl
                bg-white shadow-xl dark:bg-gray-900">

        <div class="flex items-center justify-between
                    border-b border-gray-200 px-6 py-4
                    dark:border-gray-700">

            <h2 id="modal-title"
                class="text-xl font-bold">
                Dodaj nauczyciela
            </h2>

            <button type="button"
                    onclick="closeCrudModal()"
                    class="text-2xl text-gray-400">
                &times;
            </button>
        </div>

        <form id="teacher-form"
              onsubmit="handleFormSubmit(event)"
              class="space-y-5 p-6">

            <input id="form-id" type="hidden" />

            <div>
                <label for="form-academicTitle"
                       class="mb-1 block text-sm font-medium">
                    Tytuł naukowy
                </label>

                <input id="form-academicTitle"
                       type="text"
                       maxlength="50"
                       placeholder="Np. dr inż."
                       class="w-full rounded-lg border px-3 py-2
                              dark:bg-gray-800" />
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

                <div>
                    <label for="form-firstName"
                           class="mb-1 block text-sm font-medium">
                        Imię
                    </label>

                    <input id="form-firstName"
                           type="text"
                           required
                           maxlength="100"
                           class="w-full rounded-lg border px-3 py-2
                                  dark:bg-gray-800" />
                </div>

                <div>
                    <label for="form-lastName"
                           class="mb-1 block text-sm font-medium">
                        Nazwisko
                    </label>

                    <input id="form-lastName"
                           type="text"
                           required
                           maxlength="100"
                           class="w-full rounded-lg border px-3 py-2
                                  dark:bg-gray-800" />
                </div>
            </div>

            <div>
                <label for="form-email"
                       class="mb-1 block text-sm font-medium">
                    E-mail
                </label>

                <input id="form-email"
                       type="email"
                       maxlength="200"
                       class="w-full rounded-lg border px-3 py-2
                              dark:bg-gray-800" />
            </div>

            <div class="flex justify-end gap-3 border-t pt-5">

                <button type="button"
                        onclick="closeCrudModal()"
                        class="rounded-lg border px-4 py-2
                               text-sm font-semibold">
                    Anuluj
                </button>

                <button type="submit"
                        class="rounded-lg bg-blue-600 px-4 py-2
                               text-sm font-semibold text-white">
                    Zapisz
                </button>
            </div>
        </form>
    </div>
</div>