@model IEnumerable<WebApplication.DTOs.Admin.UserListDto>
@{
    ViewData["Title"] = "Zarządzanie Użytkownikami";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="px-8 pt-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Panel Administratora</h1>
    <partial name="Partials/_AdminNav" />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
            <h2 class="text-lg font-bold text-gray-800 dark:text-gray-200 mb-4">Zarejestrowani użytkownicy</h2>
            <div class="bg-card border border-border rounded-2xl shadow-sm overflow-x-auto">
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="bg-gray-50 dark:bg-gray-800/50 border-b border-border text-left">
                            <th class="p-4 text-xs font-bold text-gray-500 uppercase w-16">ID</th>
                            <th class="p-4 text-xs font-bold text-gray-500 uppercase">Login</th>
                            <th class="p-4 text-xs font-bold text-gray-500 uppercase">Rola</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var user in Model)
                        {
                            <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/20 transition-colors">
                                <td class="p-4 text-sm text-gray-500">@user.Id</td>
                                <td class="p-4 text-sm font-semibold text-gray-900 dark:text-gray-100">@user.Username</td>
                                <td class="p-4 text-sm text-gray-600 dark:text-gray-400">
                                    <span class="px-2 py-1 text-xs font-bold rounded-md bg-purple-50 text-purple-700 border border-purple-200">
                                        @user.RoleName
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div>
            <h2 class="text-lg font-bold text-gray-800 dark:text-gray-200 mb-4">Utwórz konto</h2>
            <div class="bg-card border border-border rounded-2xl shadow-sm p-6">
                <form asp-controller="Admin" asp-action="CreateAccount" method="post" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold uppercase text-gray-400">Login:</label>
                        <input type="text" name="username" required class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none"/>
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-gray-400">E-mail:</label>
                        <input type="email" name="email" required class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none"/>
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-gray-400">Hasło tymczasowe:</label>
                        <input type="password" name="tempPassword" required class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none"/>
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-gray-400">Wybierz Rolę:</label>
                        <select name="roleId" asp-items="ViewBag.Roles" required class="w-full bg-gray-100 dark:bg-gray-800 rounded-xl px-4 py-2 text-sm mt-1 border-none">
                            <option value="">-- Wybierz --</option>
                        </select>
                    </div>
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="text-red-600 text-xs font-semibold bg-red-50 p-3 rounded-xl border border-red-200"></div>
                    }
                    <button type="submit" class="w-full py-2.5 bg-green-600 text-white rounded-xl text-sm font-bold shadow-md hover:bg-green-700">Utwórz konto</button>
                </form>
            </div>
        </div>
    </div>
</div>