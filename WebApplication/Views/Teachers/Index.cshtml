@model IEnumerable<WebApplication.DTOs.Teacher.TeacherDto>

@section HeaderLeft {
    <div class="flex items-center gap-4">
        <h2 class="font-bold text-2xl tracking-tight">Teachers</h2>
    </div>
}

<div class="p-8 space-y-6">
    <div class="bg-card border border-border rounded-2xl p-6 shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="text-xs font-bold text-gray-400 uppercase">Search Teacher</label>
                <div class="relative mt-1">
                    <input type="text" id="search-input" placeholder="Search by name, email..."
                           class="w-full bg-gray-100 dark:bg-gray-800 border-none rounded-xl px-4 py-2.5 pl-10 text-sm focus:ring-2 focus:ring-blue-500/20" />
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                        <i data-lucide="search" class="w-4 h-4"></i>
                    </div>
                </div>
            </div>

            <div>
                <label class="text-xs font-bold text-gray-400 uppercase">Academic Title</label>
                <select id="title-filter"
                        class="w-full bg-gray-100 dark:bg-gray-800 border-none rounded-xl px-4 py-2.5 text-sm mt-1 focus:ring-2 focus:ring-blue-500/20">
                    <option value="">All Titles</option>
                </select>
            </div>
        </div>
    </div>

    <div class="bg-card rounded-xl border border-border overflow-hidden shadow-sm">
        <table class="w-full text-left border-collapse">
            <thead>
            <tr class="border-b border-border bg-gray-50/50 dark:bg-gray-800/50">
                <th class="px-6 py-4 font-semibold text-sm text-gray-500 uppercase">Teacher</th>
                <th class="px-6 py-4 font-semibold text-sm text-gray-500 uppercase">Academic Title</th>
                <th class="px-6 py-4 font-semibold text-sm text-gray-500 uppercase">Email Address</th>
            </tr>
            </thead>
            <tbody id="teachers-list" class="divide-y divide-border">
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const STORAGE_KEY = 'teachers_cache';
        const TTL = 3600000;

        let allTeachers = [];

        function initTeachers() {
            const serverData = @Html.Raw(Json.Serialize(Model));
            const cached = JSON.parse(localStorage.getItem(STORAGE_KEY));
            const now = Date.now();

            if (serverData && serverData.length > 0) {
                allTeachers = serverData;
                localStorage.setItem(STORAGE_KEY, JSON.stringify({data: serverData, timestamp: now}));
            } else if (cached && (now - cached.timestamp < TTL)) {
                allTeachers = cached.data;
            }

            populateTitleFilter(allTeachers);
            setupEventListeners();
            filterAndRenderTeachers();
        }

        function populateTitleFilter(teachers) {
            const titleFilter = document.getElementById('title-filter');
            const uniqueTitles = [...new Set(teachers.map(t => t.title).filter(Boolean))].sort();
            
            uniqueTitles.forEach(title => {
                const opt = new Option(title, title);
                titleFilter.add(opt);
            });
        }

        function setupEventListeners() {
            document.getElementById('search-input').addEventListener('input', filterAndRenderTeachers);
            document.getElementById('title-filter').addEventListener('change', filterAndRenderTeachers);
        }

        function filterAndRenderTeachers() {
            const searchQuery = document.getElementById('search-input').value.toLowerCase().trim();
            const selectedTitle = document.getElementById('title-filter').value;

            const filtered = allTeachers.filter(t => {
                const fullNameStr = (t.fullName || '').toLowerCase();
                const emailStr = (t.email || '').toLowerCase();
                const titleStr = (t.title || '').toLowerCase();

                const matchesSearch = !searchQuery || 
                    fullNameStr.includes(searchQuery) || 
                    emailStr.includes(searchQuery) ||
                    titleStr.includes(searchQuery);

                const matchesTitle = !selectedTitle || t.title === selectedTitle;

                return matchesSearch && matchesTitle;
            });

            renderTeachers(filtered);
        }

        function renderTeachers(teachers) {
            const list = document.getElementById('teachers-list');
            
            if (teachers.length === 0) {
                list.innerHTML = `
                    <tr>
                        <td colspan="3" class="px-6 py-12 text-center text-gray-500">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <i data-lucide="info" class="w-8 h-8 text-gray-400"></i>
                                <p class="font-medium">No teachers match the filtering criteria.</p>
                            </div>
                        </td>
                    </tr>
                `;
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
                return;
            }

            list.innerHTML = teachers.map(t => {
                const nameParts = t.fullName ? t.fullName.trim().split(/\s+/) : [];
                const initials = nameParts.length >= 2
                    ? `${nameParts[0][0]}${nameParts[nameParts.length - 1][0]}`.toUpperCase()
                    : (t.fullName ? t.fullName.substring(0, 2).toUpperCase() : "??");

                return `
                    <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 font-bold text-sm select-none">
                                    ${initials}
                                </div>
                                <div class="font-medium">${t.fullName}</div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-gray-100 dark:bg-gray-800 font-medium text-gray-700 dark:text-gray-300">
                                ${t.title || 'Brak'}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-500">
                            <div class="flex items-center gap-2">
                                <i data-lucide="mail" class="w-4 h-4"></i>
                                <a href="mailto:${t.email}" class="hover:underline text-blue-600 dark:text-blue-400 transition-colors">${t.email}</a>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        }

        initTeachers();
    </script>
}