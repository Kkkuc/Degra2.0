@{
    ViewData["Title"] = "Data Scraper";
}

@section HeaderLeft {
    <h2 class="font-bold text-2xl tracking-tight">Data Synchronization</h2>
}

<div class="p-8 max-w-4xl mx-auto">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 bg-green-100 border-l-4 border-green-500 text-green-700 rounded-r-xl flex items-center gap-3">
            <i data-lucide="check-circle" class="w-5 h-5"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded-r-xl flex items-center gap-3">
            <i data-lucide="alert-circle" class="w-5 h-5"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-card p-6 rounded-2xl border border-border shadow-sm">
            <div class="text-gray-500 text-xs uppercase font-bold mb-1">Teachers</div>
            <div class="text-3xl font-black">@ViewBag.TeacherCount</div>
        </div>
        <div class="bg-card p-6 rounded-2xl border border-border shadow-sm">
            <div class="text-gray-500 text-xs uppercase font-bold mb-1">Subjects</div>
            <div class="text-3xl font-black">@ViewBag.SubjectCount</div>
        </div>
        <div class="bg-card p-6 rounded-2xl border border-border shadow-sm">
            <div class="text-gray-500 text-xs uppercase font-bold mb-1">Schedule Entries</div>
            <div class="text-3xl font-black">@ViewBag.TimetableCount</div>
        </div>
    </div>

    <div class="bg-card rounded-3xl border border-border overflow-hidden shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-card rounded-3xl border border-border overflow-hidden shadow-sm flex flex-col justify-between">
            <div class="p-8 text-center flex-1">
                <div class="w-20 h-20 bg-blue-50 dark:bg-blue-900/20 rounded-full flex items-center justify-center mx-auto mb-6 text-blue-600">
                    <i data-lucide="refresh-cw" class="w-10 h-10"></i>
                </div>
                <h3 class="text-xl font-bold mb-2">Sync with University Portal</h3>
                <p class="text-gray-500 mb-8 max-w-sm mx-auto">This will fetch the latest teacher schedules, rooms, and subject mappings directly from the Degra portal live endpoint.</p>
                
                <form asp-controller="Scraper" asp-action="RunScraper" method="post">
                    <button type="submit" class="inline-flex items-center gap-3 px-8 py-4 bg-primary-custom text-white font-bold rounded-2xl hover:opacity-90 transition-all shadow-lg">
                        <i data-lucide="play" class="w-5 h-5"></i>
                        <span>Start Synchronization</span>
                    </button>
                </form>
            </div>
            <div class="bg-gray-50 dark:bg-gray-800/50 p-4 border-t border-border text-center">
                <span class="text-xs text-gray-400">Last synced: @(ViewBag.LastSynced ?? "Never")</span>
            </div>
        </div>

        <div class="bg-card rounded-3xl border border-border overflow-hidden shadow-sm flex flex-col justify-between">
            <div class="p-8 text-center flex-1">
                <div class="w-20 h-20 bg-emerald-50 dark:bg-emerald-900/20 rounded-full flex items-center justify-center mx-auto mb-6 text-emerald-600">
                    <i data-lucide="file-up" class="w-10 h-10"></i>
                </div>
                <h3 class="text-xl font-bold mb-2">Import from Local XML File</h3>
                <p class="text-gray-500 mb-6 max-w-sm mx-auto">Upload a previously downloaded or backup timetable dataset file directly from your local machine disk.</p>
                
                <form asp-controller="Scraper" asp-action="UploadFile" method="post" enctype="multipart/form-data" class="space-y-6">
                    <div class="max-w-xs mx-auto">
                        <input type="file" name="xmlFile" accept=".xml" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 dark:file:bg-gray-800 dark:file:text-gray-300 cursor-pointer" required />
                    </div>
                    <button type="submit" class="inline-flex items-center gap-3 px-8 py-4 bg-emerald-600 text-white rounded-2xl font-bold hover:opacity-90 transition-all shadow-lg">
                        <i data-lucide="upload" class="w-5 h-5"></i>
                        <span>Upload & Import</span>
                    </button>
                </form>
            </div>
            <div class="bg-gray-50 dark:bg-gray-800/50 p-4 border-t border-border text-center">
                <span class="text-xs text-gray-400">Supported format: .xml only</span>
            </div>
        </div>
    </div>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}