@{
    ViewData["Title"] = "Log In";
}
@if (Context.Request.Query["error"] == "BrakKontaWSystemie")
{
    <div class="bg-red-500/10 border border-red-500 text-red-500 p-4 rounded-xl text-sm mb-4 font-medium">
        ⚠️ Twój adres e-mail Google nie jest zarejestrowany w systemie. 
        Poproś administratora o dodanie tego adresu do Twojego konta.
    </div>
}
@if (Context.Request.Query["error"] == "BladGoogle")
{
    <div class="bg-red-500/10 border border-red-500 text-red-500 p-4 rounded-xl text-sm mb-4 font-medium">
        ⚠️ Nie udało się pobrać danych autoryzacyjnych z konta Google. Spróbuj ponownie.
    </div>
}
<div class="p-8 max-w-md mx-auto">
    <div class="bg-card rounded-3xl border border-border p-8 shadow-sm">
        <h2 class="text-2xl font-bold mb-6">Log In to Degra 2.0</h2>
        <form method="post" asp-action="Login">
            <div class="mb-4">
                <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Username</label>
                <input type="text" name="username" class="w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-blue-500/20" required />
            </div>
            <div class="mb-6">
                <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Password</label>
                <input type="password" name="password" class="w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-blue-500/20" required />
            </div>
            <button type="submit" class="w-full py-4 bg-primary-custom text-white font-bold rounded-xl shadow-lg hover:opacity-90 transition-all">
                Log In
            </button>
        </form>
    </div>
</div>

<div class="mt-6">
    <div class="relative flex py-2 items-center">
        <div class="flex-grow border-t border-border"></div>
        <span class="flex-shrink mx-4 text-xs text-gray-400 uppercase">Lub opcja alternatywna</span>
        <div class="flex-grow border-t border-border"></div>
    </div>

    <a asp-controller="Account" asp-action="LoginWithGoogle" 
       class="mt-4 w-full flex items-center justify-center gap-3 px-4 py-2.5 rounded-xl border border-border bg-card hover:bg-sidebar-accent/50 transition-all font-medium text-sm shadow-sm cursor-pointer">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#EA4335" d="M12 5.04c1.64 0 3.12.56 4.28 1.67l3.2-3.2C17.52 1.58 14.96 1 12 1 7.35 1 3.42 3.67 1.48 7.56l3.84 2.98C6.26 6.94 8.91 5.04 12 5.04z"/>
            <path fill="#4285F4" d="M23.49 12.27c0-.81-.07-1.59-.2-2.34H12v4.44h6.44c-.28 1.48-1.12 2.74-2.38 3.58l3.7 2.87c2.16-1.99 3.43-4.92 3.43-8.55z"/>
            <path fill="#FBBC05" d="M5.32 14.42c-.24-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29L1.48 6.86C.54 8.75 0 10.82 0 13s.54 4.25 1.48 6.14l3.84-2.98z"/>
            <path fill="#34A853" d="M12 23c3.24 0 5.97-1.07 7.96-2.92l-3.7-2.87c-1.03.69-2.34 1.1-3.96 1.1-3.09 0-5.74-1.9-6.68-4.51L1.48 16.8C3.42 20.33 7.35 23 12 23z"/>
        </svg>
        <span>Zaloguj przez konto Google</span>
    </a>
</div>