@{
    ViewData["Title"] = "Log In";
}

<div class="p-8 max-w-md mx-auto">
    <div class="bg-card rounded-3xl border border-border p-8 shadow-sm">
        <h2 class="text-2xl font-bold mb-6">Log In to Degra 2.0</h2>
        <form method="post" asp-action="Login">
            <div class="mb-4">
                <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Username</label>
                <input type="text" name="username" class="w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-blue-500/20" required />
            </div>
            <div class="mb-6">
                <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Password</label>
                <input type="password" name="password" class="w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border-none rounded-xl text-sm focus:ring-2 focus:ring-blue-500/20" required />
            </div>
            <button type="submit" class="w-full py-4 bg-primary-custom text-white font-bold rounded-xl shadow-lg hover:opacity-90 transition-all">
                Log In
            </button>
        </form>
    </div>
</div>